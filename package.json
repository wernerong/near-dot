{
  "name": "near-dot",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run version:check && tsc --noEmit && vite build",
    "test": "vitest run",
    "test:rust": "node scripts/test-rust.mjs",
    "test:ui": "playwright test",
    "tauri": "tauri",
    "check": "npm run build && npm test && npm run test:rust",
    "release:config": "node scripts/release-config.mjs",
    "version:check": "node scripts/versions.mjs",
    "version:set": "node scripts/versions.mjs --set"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
